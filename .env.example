# Copy to .env.local and fill in. Never commit real values.

# --- Required ---

# PostgreSQL (rate limiting, anonymous usage stats, field reports, admin accounts).
# Create the tables with: npm run db:migrate
DATABASE_URL=postgresql://user:password@localhost:5432/dalil

# AI assistant (Gemini). Free key: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Voice transcription (Whisper on Groq). Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Admin auth (better-auth). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app (Vercel sets VERCEL_URL automatically in preview/production).
BETTER_AUTH_URL=http://localhost:3000

# Only these emails can create an admin account (comma-separated).
ADMIN_EMAILS=admin@example.com

# Salt used to hash IPs for rate limiting. Generate with: openssl rand -hex 32
RATE_LIMIT_SALT=
