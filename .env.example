# Base de données PostgreSQL (optionnel pour le développement)
DATABASE_URL=postgresql://user:password@localhost:5432/dalil

# Authentification (optionnel pour le développement)
BETTER_AUTH_URL=http://localhost:3000
ADMIN_EMAILS=admin@example.com,moderator@example.com

# Rate limiting (optionnel pour le développement)
RATE_LIMIT_SALT=your-secret-salt-here

# OpenAI API (optionnel - pour transcription vocale et TTS)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google AI API (OBLIGATOIRE pour l'assistant AI)
# Obtenez votre clé ici: https://makersuite.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-api-key-here

# Vercel (optionnel, pour le déploiement)
VERCEL_URL=
VERCEL_PROJECT_PRODUCTION_URL=

# Environnement
NODE_ENV=development
